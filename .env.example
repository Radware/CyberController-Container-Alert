# Container Watchdog — environment variables
# Copy to .env and fill in before running docker compose up --build
# chmod 600 .env after editing

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Splunk HEC ────────────────────────────────────────────────────────────────
SPLUNK_HEC_URL=https://your-splunk-server:8088
SPLUNK_HEC_TOKEN=your_splunk_hec_token_here

# ── Tuning ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
